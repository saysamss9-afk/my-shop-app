{
  "expo": {
    "name": "My Shop",
    "slug": "my-shop",
    "version": "1.0.0",
    "sdkVersion": "51.0.0",
    "orientation": "portrait",
    "icon": "./icon-user.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./icon-user.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to the camera to scan barcodes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./icon-user.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.abijahshops",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "This app needs access to your camera to scan barcodes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9ec931aa-98bb-4736-a709-ad2178bb3dc1"
      }
    },
    "owner": "saysmanage"
  }
}
