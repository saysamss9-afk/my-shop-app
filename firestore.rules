rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    // Replace "YOUR_SPECIFIC_FIREBASE_UID" with your actual UID from Firebase Console
    function isAppOwner() {
      return isAuthenticated() && request.auth.uid == "l2JP5nnzVSP6gd8aSDEqI60Tbfl2";
    }

    // Check if user is the direct owner of the shop in registered_shops
    function isShopOwner(shopId) {
      return isAuthenticated() && (
        isAppOwner() ||
        (exists(/databases/$(database)/documents/registered_shops/$(shopId)) &&
         get(/databases/$(database)/documents/registered_shops/$(shopId)).data.ownerId == request.auth.uid)
      );
    }

    // Check if user is staff of a shop
    function isStaff(shopId) {
      return isAuthenticated() && (
        isAppOwner() ||
        isShopOwner(shopId) ||
        (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.shopId == shopId)
      );
    }

    // Check if user is Manager or Owner of a shop
    function isManager(shopId) {
      return isAuthenticated() && (
        isAppOwner() ||
        isShopOwner(shopId) ||
        (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.shopId == shopId &&
         (get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == "OWNER" ||
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == "MANAGER"))
      );
    }

    // --- Collection Rules ---

    // Registered Shops (Global metadata)
    match /registered_shops/{shopId} {
      // Anyone can verify a specific shop code (get)
      allow get: if true;
      // Only authenticated users can list shops
      allow list: if isAuthenticated();
      // Only the App Owner can create new registered shops
      allow create: if isAppOwner();
      // Only the owner of the shop or App Owner can update metadata
      allow update: if isAppOwner() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAppOwner();
    }

    // Shop Requests (Users request a shop to be created)
    match /shop_requests/{requestId} {
      allow read: if isAppOwner();
      allow create: if true; // Allow anyone to submit a shop request
      allow update, delete: if isAppOwner();
    }

    // Root Employees collection (used for login and staff management)
    match /employees/{uid} {
      // Users can read and write their own profile
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      // Managers can read and update staff records for their shop
      allow read, update, delete: if isAuthenticated() && isManager(resource.data.shopId);
    }

    // Shop-scoped data
    match /shops/{shopId} {
      allow get: if isAuthenticated();

      // Products & Inventory: Staff can manage daily operations, Managers can delete
      match /products/{productId} {
        allow read, create, update: if isStaff(shopId);
        allow delete: if isManager(shopId);
      }

      match /categories/{categoryId} {
        allow read, create, update: if isStaff(shopId);
        allow delete: if isManager(shopId);
      }

      // Sales: Staff can record sales, Managers can view/edit history
      match /sales/{saleId} {
        allow read, create: if isStaff(shopId);
        allow update, delete: if isManager(shopId);
      }

      // Suppliers: Staff can manage contacts, Managers can delete
      match /suppliers/{supplierId} {
        allow read, create, update: if isStaff(shopId);
        allow delete: if isManager(shopId);
      }

      // Payments (Customer Debt Payments)
      match /payments/{paymentId} {
        allow read, write: if isStaff(shopId);
      }

      // Supplier Payments
      match /supplier_payments/{paymentId} {
        allow read, write: if isStaff(shopId);
      }

      // Customers & Debts
      match /customers/{customerId} {
        allow read, write: if isStaff(shopId);
      }

      // Expenses & Audit Logs: Restricted to Managers
      match /expenses/{expenseId} {
        allow read, write: if isManager(shopId);
      }

      match /audit_logs/{logId} {
        allow read: if isManager(shopId);
        allow create: if isStaff(shopId); // Allow staff to trigger logs
        allow update, delete: if false;   // Logs should be immutable
      }
    }
  }
}
