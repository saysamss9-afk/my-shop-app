rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAppOwner() {
      return isAuthenticated() && request.auth.uid == "l2JP5nnzVSP6gd8aSDEqI60Tbfl2";
    }

    // Get shop metadata from the registered_shops collection
    function getShopData(shopId) {
      return get(/databases/$(database)/documents/registered_shops/$(shopId)).data;
    }

    // Check if user is the owner of a shop or owner of its parent shop
    function isShopOwner(shopId) {
      return isAuthenticated() && (
        isAppOwner() ||
        (exists(/databases/$(database)/documents/registered_shops/$(shopId)) && (
          getShopData(shopId).get('ownerId', null) == request.auth.uid ||
          ((getShopData(shopId).get('ownerId', null) == null || getShopData(shopId).get('ownerId', '') == '') &&
           exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('shopId', null) == shopId &&
           get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('role', 'SALES') == "OWNER") ||
          (getShopData(shopId).get('parentShopId', null) != null &&
           exists(/databases/$(database)/documents/registered_shops/$(getShopData(shopId).parentShopId)) &&
           (getShopData(getShopData(shopId).parentShopId).get('ownerId', null) == request.auth.uid ||
            ((getShopData(getShopData(shopId).parentShopId).get('ownerId', null) == null || getShopData(getShopData(shopId).parentShopId).get('ownerId', '') == '') &&
             exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('shopId', null) == getShopData(shopId).parentShopId &&
             get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('role', 'SALES') == "OWNER")))
        ))
      );
    }

    // Check if user is a staff member of a shop
    function isStaff(shopId) {
      return isAuthenticated() && (
        isAppOwner() ||
        isShopOwner(shopId) ||
        (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('shopId', null) == shopId)
      );
    }

    // Check if user is Manager or Owner of a shop
    function isManager(shopId) {
      return isAuthenticated() && (
        isAppOwner() ||
        isShopOwner(shopId) ||
        (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('shopId', null) == shopId &&
         (get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('role', 'SALES') in ['OWNER', 'MANAGER']))
      );
    }

    // Logic to enforce plan-based staff limits
    function canJoinShop(shopId) {
      return exists(/databases/$(database)/documents/registered_shops/$(shopId)) &&
             (getShopData(shopId).get('plan', 'STARTER') != "STARTER" ||
              getShopData(shopId).get('staffCount', 0) < 3);
    }

    // --- Collection Rules ---

    // Public lookup mapping for friendly branch registration codes
    match /shop_codes/{shopCode} {
      allow get: if true;
      allow create: if isAppOwner() || (
        isAuthenticated() && (
          (request.resource.data.get('parentShopId', null) != null && isShopOwner(request.resource.data.parentShopId)) ||
          isShopOwner(request.resource.data.shopId)
        )
      );
      allow delete: if isAppOwner() || isShopOwner(resource.data.shopId);
    }

    // Registered Shops metadata
    match /registered_shops/{shopId} {
      allow get: if true;
      allow list: if isAppOwner() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);

      // Create main shop (Admin) or Branch (Premium Owner)
      allow create: if isAppOwner() || (
        isAuthenticated() &&
        request.resource.data.get('parentShopId', null) != null &&
        isShopOwner(request.resource.data.parentShopId) &&
        getShopData(request.resource.data.parentShopId).get('plan', 'STARTER') == "PREMIUM" &&
        getShopData(request.resource.data.parentShopId).get('branchCount', 0) < 4
      );

      // Owner/Admin updates, Staff increment staffCount, or Owner claims unassigned shop
      allow update: if isAppOwner() || (
        isAuthenticated() && (
          isShopOwner(shopId) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staffCount']) &&
           request.resource.data.get('staffCount', 0) == resource.data.get('staffCount', 0) + 1) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['branchCount'])) ||
          // Special case: Owner claims their shop record if ownerId is missing
          ((resource.data.get('ownerId', null) == null || resource.data.get('ownerId', '') == '') &&
           request.resource.data.ownerId == request.auth.uid &&
           exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('shopId', null) == shopId &&
           get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('role', 'SALES') == "OWNER")
        )
      );

      allow delete: if isAppOwner() || isShopOwner(shopId);
    }

    // Shop Requests
    match /shop_requests/{requestId} {
      allow read: if isAppOwner() || (isAuthenticated() && (
        resource.data.get('userId', null) == request.auth.uid ||
        resource.data.get('userEmail', '') == request.auth.token.email
      ));
      allow create: if true;
      allow update, delete: if isAppOwner();
    }

    // Plan Upgrades
    match /plan_upgrade_requests/{id} {
      allow read: if isAppOwner();
      allow create: if isAuthenticated();
      allow update, delete: if isAppOwner();
    }

    // Employee Records
    match /employees/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isManager(resource.data.get('shopId', '')));
      allow create: if isAuthenticated() && request.auth.uid == uid && canJoinShop(request.resource.data.get('shopId', ''));
      allow update, delete: if isAuthenticated() && (request.auth.uid == uid || isManager(resource.data.get('shopId', '')));
    }

    // Shop data (Products, Sales, etc.)
    match /shops/{shopId} {
      allow get: if isAuthenticated();

      match /{document=**} {
        allow read, write: if isStaff(shopId);
      }
    }
  }
}
